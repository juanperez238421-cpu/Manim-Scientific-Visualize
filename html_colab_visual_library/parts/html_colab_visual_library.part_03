def browser_frame(width: float = 9.6, height: float = 3.25, url: str = "localhost:8000") -> VGroup:
    shell = rounded_box(width, height, fill=COLAB_SURFACE, stroke=COLAB_BORDER_DARK, radius=0.09)
    chrome = Rectangle(
        width=width,
        height=0.43,
        fill_color="#F1F3F4",
        fill_opacity=1,
        stroke_color=COLAB_BORDER_DARK,
        stroke_width=1,
    ).align_to(shell, UP)
    dots = VGroup(
        Circle(radius=0.045, fill_color="#EA4335", fill_opacity=1, stroke_width=0),
        Circle(radius=0.045, fill_color="#FBBC04", fill_opacity=1, stroke_width=0),
        Circle(radius=0.045, fill_color="#34A853", fill_opacity=1, stroke_width=0),
    ).arrange(RIGHT, buff=0.08)
    dots.move_to(chrome.get_left() + RIGHT * 0.32)
    address = rounded_box(width - 1.35, 0.24, fill=COLAB_SURFACE, stroke=COLAB_BORDER, radius=0.09)
    address.move_to(chrome.get_center() + RIGHT * 0.22)
    address_text = ui_text(url, 10.5, COLAB_MUTED).move_to(address)
    return VGroup(shell, chrome, dots, address, address_text)


def market_header(width: float = 8.95, compact: bool = False) -> VGroup:
    height = 1.15 if not compact else 0.92
    panel = Rectangle(width=width, height=height, fill_color=COLAB_SURFACE, fill_opacity=1, stroke_width=0)
    panel.set_stroke(MARKET_BORDER, width=0.7)
    eyebrow = ui_text("SEMINARIO DE PROGRAMACIÓN · ENTREGA DE REFERENCIA", 10, MARKET_BLUE, BOLD)
    title = ui_text("Robledo Market Lab", 27 if not compact else 22, MARKET_INK, BOLD)
    copy = ui_text(
        "Aplicación web local con HTML, CSS y JavaScript.",
        12,
        MARKET_MUTED,
    )
    eyebrow.move_to(panel.get_corner(UL) + [0.22 + eyebrow.width / 2, -0.20, 0])
    title.next_to(eyebrow, DOWN, aligned_edge=LEFT, buff=0.06)
    copy.next_to(title, DOWN, aligned_edge=LEFT, buff=0.04)

    badge = rounded_box(1.55, 0.25, fill=MARKET_BLUE_SOFT, stroke=MARKET_BLUE, radius=0.12)
    badge_text = ui_text("Versión 1.1.0", 9.5, MARKET_BLUE, BOLD).move_to(badge)
    badge.move_to(panel.get_corner(UR) + [-0.95, -0.25, 0])
    badge_text.move_to(badge)
    return VGroup(panel, eyebrow, title, copy, badge, badge_text)


def market_button(label: str, width: float = 1.45, primary: bool = True) -> VGroup:
    fill = MARKET_BLUE_DARK if primary else COLAB_SURFACE
    stroke = MARKET_BLUE_DARK if primary else MARKET_BORDER
    color = WHITE if primary else MARKET_BLUE_DARK
    button = rounded_box(width, 0.34, fill=fill, stroke=stroke, radius=0.07)
    text = ui_text(label, 10.5, color, BOLD).move_to(button)
    return VGroup(button, text)


def market_field(label: str, placeholder: str, width: float = 2.3) -> VGroup:
    label_text = ui_text(label, 10.5, MARKET_INK, BOLD)
    field = rounded_box(width, 0.38, fill=COLAB_SURFACE, stroke=MARKET_BORDER, radius=0.06)
    placeholder_text = ui_text(placeholder, 9.5, MARKET_MUTED)
    label_text.align_to(field, LEFT)
    label_text.next_to(field, UP, aligned_edge=LEFT, buff=0.07)
    placeholder_text.move_to(field.get_left() + [0.12 + placeholder_text.width / 2, 0, 0])
    return VGroup(label_text, field, placeholder_text)


def product_card(name: str, price: str, icon: str, width: float = 2.12) -> VGroup:
    card = rounded_box(width, 1.34, fill=COLAB_SURFACE, stroke=MARKET_BORDER, radius=0.10)
    icon_box = rounded_box(0.46, 0.46, fill=MARKET_BLUE_SOFT, stroke=MARKET_BLUE_SOFT, radius=0.10)
    icon_text = ui_text(icon, 16, MARKET_BLUE_DARK, BOLD).move_to(icon_box)
    icon_box.move_to(card.get_corner(UL) + [0.34, -0.34, 0])
    icon_text.move_to(icon_box)
    title = ui_text(name, 11.5, MARKET_INK, BOLD)
    title.next_to(icon_box, RIGHT, buff=0.12)
    price_text = ui_text(price, 12.5, MARKET_INK, BOLD)
    price_text.move_to(card.get_corner(DL) + [0.42, 0.26, 0])
    button = market_button("Agregar", 0.92, primary=True)
    button.move_to(card.get_corner(DR) + [-0.55, 0.25, 0])
    return VGroup(card, icon_box, icon_text, title, price_text, button)


# ---------------------------------------------------------------------------
# Lesson 01 — What HTML is
# ---------------------------------------------------------------------------
class HTML01WhatIsHTML(ColabHTMLLesson):
    spec = LessonSpec(
        1,
        "HTML_01_What_Is_HTML.ipynb",
        "¿Qué es HTML y qué hace el navegador?",
        "Comprender HTML como estructura, no como decoración ni programación.",
        (
            "HTML significa HyperText Markup Language.",
            "Las etiquetas describen la función y jerarquía del contenido.",
            "El navegador interpreta el documento y construye una página visible.",
        ),
        (
            "<!DOCTYPE html>",
            '<html lang="es">',
            "  <head>",
            "    <title>Robledo Market Lab</title>",
            "  </head>",
            "  <body>",
            "    <h1>Robledo Market Lab</h1>",
            "    <p>Mi primera interfaz web.</p>",
            "  </body>",
            "</html>",
        ),
        (
            (1, "Activa el estándar HTML5"),
            (2, "Contenedor raíz del documento"),
            (3, "Información para el navegador"),
            (6, "Contenido que verá el usuario"),
            (7, "Título principal visible"),
        ),
        (
            "HTML organiza contenido mediante etiquetas anidadas.",
            "head configura el documento; body construye la interfaz visible.",
            "El navegador transforma el archivo en una estructura renderizada.",
        ),
    )

    def build_output(self) -> VGroup:
        frame = browser_frame(height=2.65)
        heading = ui_text("Robledo Market Lab", 30, MARKET_INK, BOLD)
        paragraph = ui_text("Mi primera interfaz web.", 17, MARKET_MUTED)
        heading.move_to(frame[0].get_center() + UP * 0.25)
        paragraph.next_to(heading, DOWN, buff=0.20)

        dom = VGroup(
            code_text("html", 12, COLAB_BLUE),
            code_text("├── head", 12, COLAB_BLUE),
            code_text("│   └── title", 12, COLAB_BLUE),
            code_text("└── body", 12, COLAB_BLUE),
            code_text("    ├── h1", 12, COLAB_BLUE),
            code_text("    └── p", 12, COLAB_BLUE),
        ).arrange(DOWN, aligned_edge=LEFT, buff=0.04)
        dom_box = rounded_box(2.15, 1.48, fill="#FBFBFB", stroke=COLAB_BORDER, radius=0.07)
        dom.move_to(dom_box)
        dom_group = VGroup(dom_box, dom)
        dom_group.move_to(frame[0].get_corner(DR) + [-1.28, 0.88, 0])
        heading.shift(LEFT * 1.10)
        paragraph.shift(LEFT * 1.10)
        return VGroup(frame, heading, paragraph, dom_group)

    def animate_output_relationships(self, output: VGroup):
        self.play(Indicate(output[1], color=MARKET_BLUE), run_time=0.8)
        self.play(Indicate(output[2], color=MARKET_BLUE), run_time=0.8)
        self.play(Circumscribe(output[3], color=COLAB_BLUE), run_time=1.0)


