        "Diferenciar configuración invisible y contenido visible.",
        (
            "head contiene metadatos, título, estilos y recursos.",
            "body contiene encabezados, secciones, botones, formularios e imágenes.",
            "Una página profesional necesita ambos bloques correctamente cerrados.",
        ),
        (
            "<!DOCTYPE html>",
            '<html lang="es">',
            "  <head>",
            '    <meta charset="UTF-8">',
            '    <meta name="viewport" content="width=device-width, initial-scale=1.0">',
            "    <title>Robledo Market Lab</title>",
            '    <link rel="stylesheet" href="css/styles.css">',
            "  </head>",
            "  <body>",
            "    <header>...</header>",
            "    <main>...</main>",
            "    <footer>...</footer>",
            "  </body>",
            "</html>",
        ),
        (
            (4, "Codificación correcta de caracteres"),
            (5, "Diseño adaptable a pantallas"),
