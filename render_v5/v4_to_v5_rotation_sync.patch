@@ -39,6 +39,31 @@
 # increasing the effective size of every 2D generator and 3D revolved body.
 GEOMETRY_SCALE = 1.22
 
+# Revolution convention: Manim positive rotation about +Y (UP) follows the
+# right-hand rule. Therefore a point that starts at (r, y, 0) moves as
+# (r cos(theta), y, -r sin(theta)). Every generated sweep object uses this
+# same mapping so the visible 2D generator and the emerging 3D volume always
+# travel in the same physical direction.
+REVOLUTION_AXIS = UP
+
+def revolve_point(radius: float, y: float, theta: float) -> np.ndarray:
+    return np.array([
+        GEOMETRY_SCALE * radius * math.cos(theta),
+        GEOMETRY_SCALE * y,
+        -GEOMETRY_SCALE * radius * math.sin(theta),
+    ])
+
+def validate_revolution_kinematics() -> None:
+    """Numerically lock the sweep parameterization to Rotate(..., axis=UP)."""
+    for theta in (0.0, PI / 2, PI, 3 * PI / 2, TAU):
+        c, sn = math.cos(theta), math.sin(theta)
+        # Standard right-hand rotation matrix around +Y.
+        ry = np.array([[c, 0.0, sn], [0.0, 1.0, 0.0], [-sn, 0.0, c]])
+        p0 = np.array([GEOMETRY_SCALE, 0.0, 0.0])
+        expected = ry @ p0
+        actual = revolve_point(1.0, 0.0, theta)
+        assert np.allclose(actual, expected, atol=1e-12), (theta, actual, expected)
+
 
