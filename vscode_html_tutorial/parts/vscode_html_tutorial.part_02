        self,
        lines: Sequence[str],
        start_line: int = 1,
        origin: np.ndarray | None = None,
        line_spacing: float = 0.40,
        font_size: float = 20,
        time_per_char: float = 0.017,
        pause_between_lines: float = 0.06,
        line_callback=None,
    ) -> VGroup:
        """Dedicated reusable code-writing animation with syntax highlighting.

        Each line is laid out in the VS Code editor, typed character-by-character
        using ``AddTextLetterByLetter``, and followed by a blinking cursor. The
        function returns the complete VGroup so later lessons can highlight or
        transform individual lines without rebuilding the code.
        """
        origin = origin if origin is not None else self.editor_code_origin()
        code_group = VGroup()
        cursor = make_cursor(0.26)
        self.add(cursor)
        for idx, line in enumerate(lines):
            row = self.code_row(start_line + idx, line, font_size)
            row.align_to(origin, LEFT)
            row.set_y(origin[1] - idx * line_spacing)
            row[0].set_opacity(0)
            self.add(row[0])
            self.play(FadeIn(row[0], run_time=0.15))
            if len(line) == 0:
                cursor.move_to([row[0].get_right()[0] + 0.40, row.get_y(), 0])
                self.wait(0.12)
            else:
                cursor.move_to(row[1].get_left() + LEFT * 0.01)
                self.play(
                    AddTextLetterByLetter(row[1], time_per_char=time_per_char),
                    cursor.animate.next_to(row[1], RIGHT, buff=0.035),
                    run_time=max(0.28, len(line) * time_per_char),
                )
            code_group.add(row)
            if line_callback:
                line_callback(idx, row, code_group)
            self.wait(pause_between_lines)
        self.play(FadeOut(cursor), run_time=0.25)
        return code_group

    def highlight_code_block(
        self,
        code_group: VGroup,
        first_index: int,
        last_index: int,
        accent: str,
        fill_opacity: float = 0.09,
    ) -> RoundedRectangle:
        target = VGroup(*[code_group[i] for i in range(first_index, last_index + 1)])
        box = SurroundingRectangle(
            target,
            buff=0.13,
            corner_radius=0.08,
            stroke_color=accent,
            stroke_width=1.6,
            fill_color=accent,
            fill_opacity=fill_opacity,
        )
        self.play(Create(box), run_time=0.55)
        return box

    def keyboard_shortcut(self, keys: Sequence[str], label: str, position: Sequence[float]) -> VGroup:
        keys_group = VGroup()
        for index, key in enumerate(keys):
            keys_group.add(keyboard_key(key, width=max(0.48, 0.18 + 0.13 * len(key))))
            if index < len(keys) - 1:
                keys_group.add(ui_text("+", 12, TEXT_MUTED))
        keys_group.arrange(RIGHT, buff=0.07)
        label_mob = ui_text(label, 14, TEXT, BOLD)
        group = VGroup(label_mob, keys_group).arrange(RIGHT, buff=0.20)
        box = SurroundingRectangle(group, buff=0.12, corner_radius=0.07, stroke_color=CYAN, fill_color="#13222D", fill_opacity=0.95)
        group.move_to(box)
        result = VGroup(box, group).move_to(position)
        self.play(FadeIn(result, shift=UP * 0.05), run_time=0.45)
        return result

    def lesson_complete(self, text: str) -> None:
        card = rr(7.0, 0.78, "#102A3A", CYAN, radius=0.15, stroke_width=1.4)
        label = ui_text(text, 24, WHITE, BOLD)
        fit_width(label, 6.55)
        label.move_to(card)
        group = VGroup(card, label).move_to([0.75, 0.10, 0])
        self.play(FadeIn(group, scale=0.95), run_time=0.65)
        self.wait(1.4)
        self.play(FadeOut(group), run_time=0.45)


class VSCode01_InterfaceTour(VSCodeTutorialBase):
    def construct(self):
        self.camera.background_color = BG
        self.setup_shell()
        cover = title_banner(
            "Visual Studio Code and HTML Basics",
            "Lesson 1 · Know the workspace before writing code",
            width=7.35,
        )
        cover.move_to([3.60, 1.86, 0])
        self.play(FadeIn(cover, scale=0.96), run_time=0.85)
        self.wait(1.2)
        self.play(FadeOut(cover), run_time=0.55)

        banner = self.show_lesson_banner("Lesson 1 · Interface tour")
        items = [
            ("Menu bar", "Commands for files, editing, running and tools.", [-3.45, 3.22, 0], [-4.75, 4.28, 0], 2.60),
            ("Activity bar", "Switch between Explorer, Search, Source Control and Extensions.", [-5.70, 1.55, 0], [-7.72, 1.72, 0], 2.70),
            ("Explorer", "Organizes project folders and files.", [-3.65, 1.20, 0], [-6.20, 1.65, 0], 2.55),
            ("Editor", "The main area where you write and inspect code.", [0.40, 1.18, 0], [-0.05, 1.40, 0], 2.65),
            ("Integrated terminal", "Run commands without leaving the editor.", [2.70, -2.42, 0], [0.55, -2.66, 0], 2.90),
            ("Status bar", "Shows language mode, position, encoding and project state.", [0.00, -3.72, 0], [0.00, -4.36, 0], 3.05),
        ]
        shown = VGroup()
        for title, body, center, target, width in items:
            callout = self.add_callout(title, body, center, target, width)
            shown.add(callout)
            self.focus(target, scale=0.78, run_time=0.55)
            self.wait(0.75)
            self.reset_camera(run_time=0.55)
            self.play(FadeOut(callout), run_time=0.28)

        self.lesson_complete("You now know where every major VS Code tool lives.")
        self.play(FadeOut(VGroup(banner, self.shell.group)), run_time=0.75)


class VSCode02_CreateProjectFolder(VSCodeTutorialBase):
    def construct(self):
        self.camera.background_color = BG
        self.setup_shell(project_name="NO FOLDER OPENED", terminal_path=r"D:\Academia\HTML")
        banner = self.show_lesson_banner("Lesson 2 · Create a project folder")

        explorer_callout = self.add_callout(
            "1. Open Explorer",
            "Your project files will appear in this panel.",
            [-3.50, 2.85, 0],
            [-6.35, 2.10, 0],
            2.60,
        )
        self.focus(self.shell.regions["sidebar"], scale=0.72)
        self.wait(0.8)
        self.reset_camera()
        self.play(FadeOut(explorer_callout), run_time=0.35)

        file_menu = rr(2.35, 2.06, "#252526", "#3A3A3A", radius=0.04)
        file_menu.move_to([-5.25, 2.80, 0])
        menu_items = VGroup(*[ui_text(item, 12.5, TEXT) for item in ["New Text File", "New File...", "New Window", "Open File...", "Open Folder...", "Open Recent"]])
        menu_items.arrange(DOWN, aligned_edge=LEFT, buff=0.15).move_to(file_menu)
        highlight = Rectangle(width=2.25, height=0.28, fill_color="#094771", fill_opacity=1, stroke_width=0).move_to(menu_items[4])
        menu_items[4].set_z_index(3)
        menu_group = VGroup(file_menu, highlight, menu_items)
        self.play(FadeIn(menu_group, shift=UP * 0.05), run_time=0.55)
        menu_callout = self.add_callout(
            "2. File → Open Folder...",
            "Choose or create one folder for the whole website.",
            [-2.70, 2.70, 0],
            menu_items[4].get_center(),
            3.00,
        )
        self.wait(1.2)

        dialog = rr(7.05, 4.25, "#F4F4F4", "#8A8A8A", radius=0.09)
        dialog.move_to([1.50, 0.30, 0])
        dialog_title = ui_text("Select Folder", 18, "#202124", BOLD).move_to(dialog.get_corner(UL) + [0.92, -0.32, 0])
        address = rr(6.30, 0.38, WHITE, "#B8B8B8", radius=0.04).move_to(dialog.get_top() + DOWN * 0.72)
        address_text = ui_text(r"D:\Academia\HTML", 13, "#303134").move_to(address.get_left() + RIGHT * 1.22)
        list_box = Rectangle(width=6.30, height=2.25, fill_color=WHITE, fill_opacity=1, stroke_color="#D0D0D0", stroke_width=1)
        list_box.next_to(address, DOWN, buff=0.18)
        folder = VGroup(ui_text("▰", 22, YELLOW), ui_text("hello_html", 15, "#202124", BOLD)).arrange(RIGHT, buff=0.15)
        folder.move_to(list_box.get_corner(UL) + [0.85, -0.45, 0])
        selected = Rectangle(width=5.95, height=0.52, fill_color="#DCEEFF", fill_opacity=1, stroke_color="#66A9E8", stroke_width=1).move_to(folder)
        select_btn = rr(1.20, 0.38, "#0E639C", "#0E639C", radius=0.04).move_to(dialog.get_corner(DR) + [-0.82, 0.38, 0])
        select_text = ui_text("Select Folder", 12, WHITE, BOLD).move_to(select_btn)
        cancel_btn = rr(0.95, 0.38, "#E5E5E5", "#B5B5B5", radius=0.04).next_to(select_btn, LEFT, buff=0.15)
        cancel_text = ui_text("Cancel", 12, "#202124").move_to(cancel_btn)
        dialog_group = VGroup(dialog, dialog_title, address, address_text, list_box, selected, folder, select_btn, select_text, cancel_btn, cancel_text)
        self.play(FadeOut(VGroup(menu_callout, menu_group)), FadeIn(dialog_group, scale=0.98), run_time=0.70)
        self.wait(1.2)
        self.play(Indicate(folder, color=BLUE), Indicate(select_btn, color=CYAN), run_time=0.90)

        new_shell = VSCodeShell("HELLO_HTML", (), None, r"D:\Academia\HTML\hello_html")
        self.play(FadeOut(dialog_group), ReplacementTransform(self.shell.group, new_shell.group), run_time=0.95)
        self.shell = new_shell
        result = self.add_callout(
            "3. Folder opened",
            "VS Code now treats HELLO_HTML as the project workspace.",
            [-3.30, 2.70, 0],
            self.shell.regions["project_header"].get_center(),
            3.00,
        )
        self.wait(1.3)
        self.play(FadeOut(result), run_time=0.35)
        self.lesson_complete("One project folder keeps HTML, CSS, images and scripts together.")
        self.play(FadeOut(VGroup(banner, self.shell.group)), run_time=0.75)


class VSCode03_CreateIndexFile(VSCodeTutorialBase):
    def construct(self):
        self.camera.background_color = BG
        self.setup_shell(project_name="HELLO_HTML", terminal_path=r"D:\Academia\HTML\hello_html")
        banner = self.show_lesson_banner("Lesson 3 · Create index.html")

        toolbar = self.shell.regions["explorer_toolbar"]
        new_file_icon = toolbar[0]
        callout = self.add_callout(
            "1. Create a new file",
            "Click the New File icon in Explorer.",
            [-3.25, -1.95, 0],
            new_file_icon.get_center(),
            2.55,
        )
        self.focus(new_file_icon, scale=0.65)
        self.play(Indicate(new_file_icon, color=CYAN), run_time=0.80)
        self.reset_camera()
        self.play(FadeOut(callout), run_time=0.30)

        input_box = rr(2.12, 0.31, "#313133", CYAN, radius=0.03, stroke_width=1.2)
        input_box.move_to([-6.23, 2.52, 0])
        input_text = mono_text("", 12.5, TEXT)
        cursor = make_cursor(0.22).move_to(input_box.get_left() + RIGHT * 0.16)
        self.play(FadeIn(input_box), FadeIn(cursor), run_time=0.35)
        file_name = "index.html"
        typed = mono_text(file_name, 12.5, TEXT)
        typed.move_to(input_box.get_left() + RIGHT * (0.13 + typed.width / 2))
        self.play(AddTextLetterByLetter(typed, time_per_char=0.10), cursor.animate.next_to(typed, RIGHT, buff=0.03), run_time=1.00)
        self.wait(0.4)
        self.play(FadeOut(VGroup(input_box, cursor)), run_time=0.30)

        new_shell = VSCodeShell("HELLO_HTML", ("index.html",), "index.html", r"D:\Academia\HTML\hello_html")
        self.play(ReplacementTransform(self.shell.group, new_shell.group), FadeIn(typed, scale=0.95), run_time=0.85)
        self.play(FadeOut(typed), run_time=0.20)
        self.shell = new_shell

        explanation = self.add_callout(
            "2. Why index.html?",
            "Web servers commonly use index.html as the default entry page.",
            [3.75, 1.55, 0],
            self.shell.regions["editor_tab"].get_center(),
            3.20,
        )
        extension = self.add_callout(
            "3. The .html extension",
            "It tells VS Code and the browser that this file contains HTML markup.",
            [3.65, 0.15, 0],
            self.shell.file_rows["index.html"].get_center(),
            3.25,
        )
        self.wait(1.8)
        self.play(FadeOut(VGroup(explanation, extension)), run_time=0.45)
        self.lesson_complete("index.html is ready. Next, we will build its document structure.")
        self.play(FadeOut(VGroup(banner, self.shell.group)), run_time=0.75)


class VSCode04_HTMLSkeleton(VSCodeTutorialBase):
    SKELETON = (
        "<!DOCTYPE html>",
