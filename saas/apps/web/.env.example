# AniMotionPDF web (M4) — copiar a .env.local. Sin secretos reales.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_AUTH_MODE=dev
# Solo desarrollo local: IdP de saas/apps/api/scripts/dev_jwks.py (NO es Clerk). Nunca activar en staging público.
DEV_AUTH=1
DEV_IDP_URL=http://127.0.0.1:9100
# Adaptador local hacia el analizador SDI real (M3). Ruta al launcher preflight.py de la skill.
M4_LOCAL_PREFLIGHT=1
SDI_PREFLIGHT_SCRIPT=/ruta/a/scientific-document-preflight/scripts/preflight.py
PYTHON_BIN=python3
# La creación de trabajos permanece desactivada salvo que se active explícitamente (y el backend/saldo lo permitan).
NEXT_PUBLIC_ENABLE_JOB_CREATION=0
