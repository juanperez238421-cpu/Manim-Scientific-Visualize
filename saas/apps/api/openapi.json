  "components": {
    "schemas": {
      "ApiErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ApiErrorBody"
      },
      "CreateJobRequest": {
        "properties": {
          "estimate_id": {
            "type": "string",
            "format": "uuid",
            "title": "Estimate Id"
          },
          "estimate_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Estimate Hash"
          },
          "max_authorized_credits": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Max Authorized Credits"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "estimate_id",
          "estimate_hash",
          "max_authorized_credits"
        ],
        "title": "CreateJobRequest"
      },
      "CreditsBalance": {
        "properties": {
          "available": {
            "type": "integer",
            "title": "Available"
          },
          "held": {
            "type": "integer",
            "title": "Held"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "available",
          "held",
          "total"
        ],
        "title": "CreditsBalance"
      },
      "EstimateRequest": {
        "properties": {
          "pdf_file_id": {
            "type": "string",
            "format": "uuid",
            "title": "Pdf File Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "solution_video",
              "hybrid_lesson"
            ],
            "title": "Kind"
          },
          "config": {
            "$ref": "#/components/schemas/JobConfig"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "pdf_file_id",
          "kind",
          "config"
        ],
        "title": "EstimateRequest"
      },
      "Job": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "solution_video",
              "hybrid_lesson"
            ],
            "title": "Kind"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled"
            ],
            "title": "Status"
          },
          "current_stage": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "extract",
                  "script",
                  "render_manim",
                  "render_prologue",
                  "render_svg",
                  "compose",
                  "upload"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Stage"
          },
          "progress_pct": {
            "type": "integer",
            "title": "Progress Pct"
          },
          "include_prologue": {
            "type": "boolean",
            "title": "Include Prologue"
          },
          "config": {
            "additionalProperties": true,
            "type": "object",
            "title": "Config"
          },
          "estimated_credits": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Estimated Credits"
          },
          "max_authorized_credits": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Authorized Credits"
          },
          "reserved_credits": {
            "type": "integer",
            "title": "Reserved Credits"
          },
          "final_credits": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Final Credits"
          },
          "cancel_requested": {
            "type": "boolean",
            "title": "Cancel Requested"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
